# 复制为 .env 后按需修改，只有下面三项需要关心，其余全部走默认：
#   cp .env.example .env

# 站点 + API 端口（宿主机），80 被占用时改这里
HTTP_PORT=80

# SQLite 与上传文件所在宿主机目录（挂载到容器 /data）
# 建议改成有备份的绝对路径，例如 /opt/spectrace/data；默认 ./data 即 compose 执行目录下的 data/
SPECTRACE_DATA_DIR=./data

# JWT 签名密钥：生产必须改，建议 32 字节以上随机串（openssl rand -hex 32）
JWT_SECRET=change-me-spectrace-jwt-secret-please-use-32bytes-min
