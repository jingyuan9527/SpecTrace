# 复制为 .env 后按需修改（docker compose 会自动读取同目录的 .env）
# 生产环境务必修改下面所有密码 / 密钥

# ===== 通用 =====
JWT_SECRET=change-me-spectrace-jwt-secret-please-use-32bytes-min
AGENT_TOKEN=spectrace-agent-callback-token
HTTP_PORT=80

# ===== 镜像（使用 CI 构建的镜像时生效）=====
# docker compose pull && docker compose up -d 可直接使用下面镜像
IMAGE_REGISTRY=ghcr.io
IMAGE_OWNER=jingyuan9527
IMAGE_TAG=latest

# ===== 外部 MySQL（默认模式使用）=====
# 宿主机上用 Docker 时可保持 host.docker.internal；远程库填其 IP/域名
MYSQL_HOST=host.docker.internal
MYSQL_PORT=3306
MYSQL_DATABASE=spectrace
MYSQL_USERNAME=root
MYSQL_PASSWORD=spectrace

# ===== 外部 Redis（默认模式使用）=====
REDIS_HOST=host.docker.internal
REDIS_PORT=6379
REDIS_PASSWORD=
# Agent 使用的完整连接串（含密码时形如 redis://:password@host:6379/0）
REDIS_URL=redis://host.docker.internal:6379/0

# ===== 内置 MySQL（仅 docker-compose.infra.yml 使用）=====
MYSQL_ROOT_PASSWORD=spectrace
