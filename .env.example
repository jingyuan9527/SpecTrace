# 复制为 .env 后按需修改，只有下面三项需要关心，其余全部走默认：
#   cp .env.example .env

# 站点 + API 端口（宿主机），80 被占用时改这里
HTTP_PORT=80

# SQLite 与上传文件所在宿主机目录（挂载到容器 /data）
# 建议改成有备份的绝对路径，例如 /opt/spectrace/data；默认 ./data 即 compose 执行目录下的 data/
SPECTRACE_DATA_DIR=./data

# JWT 签名密钥（必填，留空或不填都会拒绝启动）：
#   openssl rand -hex 32
# 本地源码启动（mvn spring-boot:run）同样必须设置 SPECTRACE_JWT_SECRET
JWT_SECRET=

# ---- 可选覆盖（不改即用默认）----

# 跨域白名单（逗号分隔，如 https://a.com,https://b.com）；留空表示任意来源，公网部署务必收敛
#SPECTRACE_CORS_ORIGINS=

# 公开接口单 IP 每分钟请求上限
#SPECTRACE_PUBLIC_QPM=120

# AI 绘图（社媒海报）：供应商与提示词在后台「AI 绘图」维护，关闭后访客端入口一并隐藏
#SPECTRACE_AI_IMAGE_ENABLED=true
#SPECTRACE_AI_IMAGE_QPM=3
#SPECTRACE_AI_IMAGE_TIMEOUT_SECONDS=120

# 增长数据保留：终态抓取任务（含过程日志）/ 已处理待审核 / 操作日志 的保留天数与清理计划
#SPECTRACE_RETENTION_ENABLED=true
#SPECTRACE_RETENTION_CRON=0 0 4 * * *
#SPECTRACE_RETENTION_TASK_DAYS=30
#SPECTRACE_RETENTION_PENDING_DAYS=30
#SPECTRACE_RETENTION_OPERATION_LOG_DAYS=90
