# ---- SpecTrace 采集 Agent（AgentScope Java 2.0）配置示例 ----
# 复制为 .env 后按需修改（本地直接运行时可 export 这些变量）

# SpringBoot 业务后端地址
SPRINGBOOT_BASE_URL=http://localhost:8080
# 与后端 spectrace.agent.callback-token 保持一致
AGENT_TOKEN=spectrace-agent-callback-token

# 任务获取方式：redis（生产，消费 Redis List） / http（本地，轮询 HTTP 接口）
AGENT_TASK_MODE=http
# AGENT_TASK_MODE=redis
REDIS_URL=redis://127.0.0.1:6379/0
AGENT_QUEUE_KEY=spectrace:agent:task
POLL_INTERVAL_SECONDS=5

# 大模型：正常情况下无需在此配置，请在后台「AI 配置」页面设置服务商/接口地址/模型/API Key。
# 以下仅作为后端不可用时的回退（fallback）配置。
DASHSCOPE_API_KEY=
DASHSCOPE_MODEL=qwen-max

# 搜索引擎：留空则使用 DuckDuckGo 免 key 抓取；填入则使用 Serper
SERPER_API_KEY=
SEARCH_RESULT_LIMIT=5

# 抓取风控：每次请求间隔（秒）与单任务最长耗时
CRAWL_INTERVAL_SECONDS=2
TASK_TIMEOUT_SECONDS=180
